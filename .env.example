# Copy this file to .env and configure before starting the server.
# Never commit the .env file — it contains secrets.

# Required: Admin login password
ADMIN_PASSWORD=change-this-to-a-private-password

# Optional: Your Judge0 server (defaults to the free public instance)
JUDGE0_URL=https://ce.judge0.com
# JUDGE0_KEY=your-judge0-auth-token

# Production only (Vercel): Upstash Redis credentials
# UPSTASH_REDIS_REST_URL=https://your-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here
