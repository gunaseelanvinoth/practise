{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].mjs"
    },
    {
      "src": "/control-room",
      "dest": "/platform.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
